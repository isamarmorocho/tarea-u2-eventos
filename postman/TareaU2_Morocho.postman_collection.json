        {
          "name": "Registrar asistente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Asistente {{runId}}\",\n  \"email\": \"ana{{runId}}@espe.edu.ec\",\n  \"password\": \"secreto123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos por corrida: la colección se puede correr dos veces seguidas",
                  "const runId = Date.now().toString(36) + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('eventCode', 'EVT-' + (1000 + Math.floor(Math.random() * 9000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registro A → 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
