// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role          Role
  appointments  Appointment[]
  registrations Registration[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  timeBlock   TimeBlock @relation(fields: [timeBlockId], references: [id])
  timeBlockId Int
}

model TimeBlock {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  endTime   DateTime
  appointments Appointment[]
}

enum Role {
  ADMIN
  USER
}

// ===== Tarea U2 · Caso 10 · Eventos =====
// Inscripción al evento: transaccional (el aforo es límite duro) → PostgreSQL.
// El catálogo de eventos vive en MongoDB; aquí solo se guarda su _id como String (sin FK).

enum RegistrationStatus {
  CONFIRMADA
  CANCELADA
}

model Registration {
  id            Int                @id @default(autoincrement())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  eventId       String?            @db.VarChar(24) // _id del Event en MongoDB
  attendeeName  String
  attendeeEmail String
  ticketCode    String             @unique
  status        RegistrationStatus @default(CONFIRMADA)
  createdAt     DateTime           @default(now())

  @@unique([userId, eventId]) // un asistente no se inscribe dos veces al mismo evento
  @@index([eventId]) // contar cupos ocupados y proteger el borrado del evento
}
